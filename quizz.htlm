<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faire le Quizz - Quel château te correspond ?</title>
  <link rel="stylesheet" href="style.css">
  <style>
    /* ===== STYLE DU QUIZZ ===== */
    body {
      background-color: #f5f5f5;
      font-family: "Poppins", sans-serif;
      color: #333;
      text-align: center;
    }

    .quiz-container {
      max-width: 700px;
      margin: 60px auto;
      background: white;
      padding: 30px 40px;
      border-radius: 15px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      animation: fadeIn 0.6s ease-in-out;
    }

    h1 {
      color: #2e4b75;
      font-size: 2em;
      margin-bottom: 15px;
    }

    .question {
      font-weight: bold;
      margin-bottom: 20px;
      font-size: 1.2em;
    }

    .answers label {
      display: block;
      background: #eef1f6;
      border-radius: 10px;
      margin: 10px 0;
      padding: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .answers label:hover {
      background: #d8e3fa;
    }

    button {
      background-color: #2e4b75;
      color: white;
      border: none;
      padding: 12px 25px;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 20px;
      transition: background-color 0.3s ease;
    }

    button:hover {
      background-color: #1d314e;
    }

    #result {
      font-size: 1.3em;
      font-weight: bold;
      color: #2e4b75;
      margin-top: 25px;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <div class="quiz-container">
    <h1>Quel château te correspond ? 🏰</h1>
    <div id="quiz">
      <div id="question-container">
        <p class="question"></p>
        <div class="answers"></div>
        <button id="next-btn">Continuer</button>
      </div>
    </div>
    <p id="result"></p>
  </div>

  <script>
    const quizData = [
      {
        question: "Que pensez-vous du pont-levis ?",
        answers: ["Indispensable sur un château", "Sympathique à voir sur un château", "Absolument pas nécessaire"]
      },
      {
        question: "Comment aimez-vous les fenêtres sur un château ?",
        answers: [
          "En grand nombre et grandes pour la lumière",
          "Un nombre suffisant et petites",
          "Peu et petites",
          "Beaucoup, peu importe la taille"
        ]
      },
      {
        question: "Quelle époque préférez-vous ?",
        answers: ["Moyen Âge", "Renaissance", "Époque moderne"]
      },
      {
        question: "Où aimez-vous que ce soit situé un château ?",
        answers: ["En hauteur, sur une colline", "Au cœur d'une forêt", "Cela n'a pas d'importance"]
      },
      {
        question: "Que pensez-vous des tours ?",
        answers: ["Plus il y en a, mieux c'est !", "C'est joli", "Ce n'est pas indispensable"]
      },
      {
        question: "Concernant le jardin, que préférez-vous ?",
        answers: ["Un grand jardin à la française", "Un petit jardin naturel", "Aucun avis"]
      },
      {
        question: "En terme de décoration intérieure, que préférez-vous ?",
        answers: [
          "De la belle tapisserie et des tableaux",
          "Une décoration sobre laissant les murs en pierre visibles",
          "Une décoration mélangeant ancien et moderne",
          "Aucune décoration"
        ]
      },
      {
        question: "Selon vous, quel est le plus important pour un château ?",
        answers: ["Sa situation géographique", "Sa beauté", "Son jardin", "Sa grandeur"]
      }
    ];

    let currentQuestion = 0;
    const questionEl = document.querySelector(".question");
    const answersEl = document.querySelector(".answers");
    const nextBtn = document.getElementById("next-btn");
    const resultEl = document.getElementById("result");

    function loadQuestion() {
      const q = quizData[currentQuestion];
      questionEl.textContent = `QUESTION ${currentQuestion + 1} / ${quizData.length} : ${q.question}`;
      answersEl.innerHTML = "";
      q.answers.forEach((answer, index) => {
        const label = document.createElement("label");
        label.innerHTML = `<input type="radio" name="answer" value="${answer}"> ${answer}`;
        answersEl.appendChild(label);
      });
    }

    nextBtn.addEventListener("click", () => {
      const selected = document.querySelector("input[name='answer']:checked");
      if (!selected) {
        alert("Veuillez sélectionner une réponse.");
        return;
      }

      currentQuestion++;
      if (currentQuestion < quizData.length) {
        loadQuestion();
      } else {
        showResult();
      }
    });

    function showResult() {
      document.getElementById("question-container").style.display = "none";
      resultEl.textContent = "✨ Ton château idéal est : le Château de Chenonceau ! Élégant, raffiné et plein de charme.";
    }

    loadQuestion();
  </script>
</body>
</html>
